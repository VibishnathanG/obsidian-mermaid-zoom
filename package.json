{
  "name": "mermaid-zoom",
  "version": "1.7.0",
  "description": "Add zoom functionality to Mermaid diagrams in Obsidian",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "plugin",
    "mermaid",
    "zoom"
  ],
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "jsdom": "^30.1.3",
    "obsidian": "^1.13.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  }
}
